{
  "name": "potok",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vinext/dist/cli.js dev",
    "build": "vinext build && node scripts/offline-assets.mjs",
    "start": "node scripts/server.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "node scripts/generate-db.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:seed": "node --env-file=.env --experimental-strip-types scripts/seed-catalog.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.2",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "tailwind-merge": "3.6.0",
    "unpdf": "^1.8.1",
    "vinext": "^1.0.0-beta.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "tw-animate-css": "1.4.0",
    "drizzle-orm": "0.45.2",
    "fake-indexeddb": "6.2.4"
  },
  "type": "module",
  "overrides": {
    "undici": "7.29.0"
  }
}
