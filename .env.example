# Copy to .env; never commit actual credentials.
# development permits localhost; production requires HTTPS APP_ORIGIN.
NODE_ENV=development
# Public DNS name, without protocol/path. Compose configures Caddy TLS.
APP_DOMAIN=app.example.com
# Allowed same-origin writes; Compose derives https:// from APP_DOMAIN.
APP_ORIGIN=http://localhost:3000
# Random hex password for the private PostgreSQL service.
POSTGRES_PASSWORD=replace_with_random_hex
# Used by local migration/seed/server commands; Compose supplies its internal URL.
DATABASE_URL=postgresql://potok:replace_with_random_hex@localhost:5432/potok
